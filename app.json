{
  "expo": {
    "name": "Auto Car Remaind",
    "slug": "autocarremind",
    "version": "2026.10.08",
    "orientation": "portrait",
    "icon": "./assets/images/logoacr.png",
    "scheme": "autocarremind",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.vspeed21.autocarremind",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/logoacr.png",
        "backgroundImage": "./assets/images/logoacr.png",
        "monochromeImage": "./assets/images/logoacr.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.vspeed21.autocarremind",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logoacr.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FFF",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3b3bece4-d542-4f0f-9b0e-4e7c0464a9ad"
      }
    }
  }
}
