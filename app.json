{
  "expo": {
    "name": "Auto Car Remaind",
    "slug": "autocarremind",
    "version": "2026.10.08",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "autocarremind",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.vspeed21.autocarremind",
      "UIBackgroundModes": [
        "location"
      ],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Auto Car Remaind usa tu ubicación para detectar tus viajes y sumar los kilómetros a tu vehículo automáticamente.",
        "NSLocationWhenInUseUsageDescription": "Auto Car Remaind usa tu ubicación para detectar tus viajes y sumar los kilómetros a tu vehículo automáticamente."
      }
    },
    "android": {
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#1D4ED8",
        "foregroundImage": "./assets/images/adaptive-foreground.png",
        "backgroundImage": "./assets/images/adaptive-background.png",
        "monochromeImage": "./assets/images/adaptive-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.vspeed21.autocarremind",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Auto Car Remaind usa tu ubicación para detectar tus viajes y sumar los kilómetros a tu vehículo automáticamente.",
          "isAndroidBackgroundLocationEnabled": true
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logoacr.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FFF",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3b3bece4-d542-4f0f-9b0e-4e7c0464a9ad"
      }
    }
  }
}